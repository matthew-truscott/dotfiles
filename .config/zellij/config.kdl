import "env.kdl"
default_shell "fish"

// Follow the desktop light/dark toggle (Super+`) live. Ghostty forwards the
// org.freedesktop.appearance change into the PTY as CSI 2031; zellij reacts and
// re-forwards it to nvim/fish in its panes. Themes defined in the `themes` block.
// `theme` is the startup/fallback appearance used until the terminal reports
// its light/dark mode (CSI 2031 / DSR 997). Set it to the dark variant so a
// fresh session opens dark instead of falling back to zellij's built-in default.
theme "kanagawa-wave"
theme_dark "kanagawa-wave"
theme_light "kanagawa-lotus"

// Kanagawa themes (style zellij's OWN chrome — pane *content* still uses
// Ghostty's palette). zellij derives the component styles from these, so the
// accents are no longer hand-picked: the focused pane border and the active
// tab chip both come from `green`, and the special-mode border from `orange`.
// The previous hand-tuned component version is in config.kdl.bak-components.
themes {
    // CLASSIC palette format, deliberately — not the newer component format
    // (text_unselected / ribbon_selected / ...). zellij parses a theme as one
    // or the other: classic only if EVERY node is a palette colour name, else
    // component (kdl/mod.rs:5219). There is no hybrid.
    //
    // It has to be classic because the bar plugins read Palette, not Styling,
    // and zellij's Styling->Palette fallback (data.rs:1565) scavenges palette
    // slots from unrelated component fields — it handed `white` the green from
    // ribbon_unselected.emphasis_1, `blue` a yellow, `orange` a blue, and
    // hardcoded theme_hue to Dark. Both bars rendered a scrambled Kanagawa.
    // Going classic makes Palette exact and lets zellij derive Styling via the
    // reverse conversion, which is coherent.
    //
    // Two conventions that look odd but are load-bearing:
    //   black/white are the BACKGROUND/FOREGROUND pair, not literal black and
    //   white — Styling picks (base, background) from them by theme_hue, which
    //   the classic format cannot set and which always resolves Dark. So the
    //   light theme puts its dark ink in `white` and its pale paper in `black`.
    //
    //   `fg` becomes ribbon_unselected's BACKGROUND (the inactive tab chip),
    //   not the text colour. That is why it is a mid-tone here.
    kanagawa-wave {
        fg "#DCD7BA"
        bg "#2A2A37"
        black "#1F1F28"
        white "#DCD7BA"
        red "#E82424"
        green "#98BB6C"
        yellow "#E6C384"
        blue "#7E9CD8"
        magenta "#957FB8"
        orange "#FFA066"
        cyan "#7FB4CA"
    }
    kanagawa-lotus {
        fg "#545464"
        bg "#E7DBA0"
        black "#F2ECBC"
        white "#545464"
        red "#C84053"
        green "#6F894E"
        yellow "#77713F"
        blue "#4D699B"
        magenta "#B35B79"
        orange "#CC6D00"
        cyan "#597B75"
    }
}

// If you'd like to override the default keybindings completely, be sure to change "keybinds" to "keybinds clear-defaults=true"
keybinds {
  normal {
    // uncomment this and adjust key if using copy_on_select=false
    // bind "Alt c" { Copy; }
  }
  locked {
    bind "Ctrl g" { SwitchToMode "Normal"; }
    // Nav that survives Locked mode (the requested bypass). These chords are
    // therefore NEVER passed through to a fullscreen app like nvim. Ctrl+Alt
    // (not Ctrl+Shift) avoids the ^H/^J/^L collapse that collides with TUIs.
    bind "Ctrl Alt h" { GoToPreviousTab; }
    bind "Ctrl Alt l" { GoToNextTab; }
    bind "Ctrl Alt j" { FocusNextPane; }
    bind "Ctrl Alt k" { FocusPreviousPane; }
    bind "Alt z" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
    bind "Alt Left" { MoveFocus "Left"; }
    bind "Alt Down" { MoveFocus "Down"; }
    bind "Alt Up" { MoveFocus "Up"; }
    bind "Alt Right" { MoveFocus "Right"; }
  }
  resize {
    bind "Ctrl n" { SwitchToMode "Normal"; }
    bind "h" "Left" { Resize "Increase Left"; }
    bind "j" "Down" { Resize "Increase Down"; }
    bind "k" "Up" { Resize "Increase Up"; }
    bind "l" "Right" { Resize "Increase Right"; }
    bind "H" { Resize "Decrease Left"; }
    bind "J" { Resize "Decrease Down"; }
    bind "K" { Resize "Decrease Up"; }
    bind "L" { Resize "Decrease Right"; }
    bind "=" "+" { Resize "Increase"; }
    bind "-" { Resize "Decrease"; }
  }
  pane {
    bind "Ctrl p" { SwitchToMode "Normal"; }
    bind "h" "Left" { MoveFocus "Left"; }
    bind "l" "Right" { MoveFocus "Right"; }
    bind "j" "Down" { MoveFocus "Down"; }
    bind "k" "Up" { MoveFocus "Up"; }
    bind "p" { SwitchFocus; }
    bind "n" { NewPane; SwitchToMode "Normal"; }
    bind "d" { NewPane "Down"; SwitchToMode "Normal"; }
    bind "r" { NewPane "Right"; SwitchToMode "Normal"; }
    bind "x" { CloseFocus; SwitchToMode "Normal"; }
    bind "f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
    bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
    bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
    bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
    bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0;}
    bind "Left" { GoToPreviousTab; }
    bind "Right" { GoToNextTab; }
  }
  move {
    bind "Ctrl h" { SwitchToMode "Normal"; }
    bind "n" "Tab" { MovePane; }
    bind "p" { MovePaneBackwards; }
    bind "h" "Left" { MovePane "Left"; }
    bind "j" "Down" { MovePane "Down"; }
    bind "k" "Up" { MovePane "Up"; }
    bind "l" "Right" { MovePane "Right"; }
  }
  tab {
    bind "Ctrl t" { SwitchToMode "Normal"; }
    bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
    // Horizontal keys reorder the tab, vertical keys cycle between tabs. Neither
    // returns to Normal, so h/h/h walks a tab across several positions in one go.
    bind "h" "Left" { MoveTab "Left"; }
    bind "l" "Right" { MoveTab "Right"; }
    bind "k" "Up" { GoToPreviousTab; }
    bind "j" "Down" { GoToNextTab; }
    // Picker rather than a bare NewTab: code (a repo under ~/code/turintech,
    // opened with code.kdl) / shell / worktree. A plain tab is still one
    // keystroke away inside it. Absolute path — KDL does not expand $HOME.
    bind "n" {
      Run "/home/matthew.t/.config/zellij/new-tab.sh" {
        floating true
        close_on_exit true
        name "new tab"
        width "50%"
        height "50%"
        x "25%"
        y "25%"
      }
      SwitchToMode "Normal"
    }
    bind "x" { CloseTab; SwitchToMode "Normal"; }
    bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
    bind "b" { BreakPane; SwitchToMode "Normal"; }
    bind "]" { BreakPaneRight; SwitchToMode "Normal"; }
    bind "[" { BreakPaneLeft; SwitchToMode "Normal"; }
    bind "1" { GoToTab 1; SwitchToMode "Normal"; }
    bind "2" { GoToTab 2; SwitchToMode "Normal"; }
    bind "3" { GoToTab 3; SwitchToMode "Normal"; }
    bind "4" { GoToTab 4; SwitchToMode "Normal"; }
    bind "5" { GoToTab 5; SwitchToMode "Normal"; }
    bind "6" { GoToTab 6; SwitchToMode "Normal"; }
    bind "7" { GoToTab 7; SwitchToMode "Normal"; }
    bind "8" { GoToTab 8; SwitchToMode "Normal"; }
    bind "9" { GoToTab 9; SwitchToMode "Normal"; }
    bind "Tab" { ToggleTab; }
  }
  scroll {
    bind "Ctrl s" { SwitchToMode "Normal"; }
    bind "e" { EditScrollback; SwitchToMode "Normal"; }
    bind "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
    bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
    bind "j" "Down" { ScrollDown; }
    bind "k" "Up" { ScrollUp; }
    bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
    bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
    bind "d" { HalfPageScrollDown; }
    bind "u" { HalfPageScrollUp; }
    // uncomment this and adjust key if using copy_on_select=false
    // bind "Alt c" { Copy; }
  }
  search {
    bind "Ctrl s" { SwitchToMode "Normal"; }
    bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
    bind "j" "Down" { ScrollDown; }
    bind "k" "Up" { ScrollUp; }
    bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
    bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
    bind "d" { HalfPageScrollDown; }
    bind "u" { HalfPageScrollUp; }
    bind "n" { Search "down"; }
    bind "p" { Search "up"; }
    bind "c" { SearchToggleOption "CaseSensitivity"; }
    bind "w" { SearchToggleOption "Wrap"; }
    bind "o" { SearchToggleOption "WholeWord"; }
  }
  entersearch {
    bind "Ctrl c" "Esc" { SwitchToMode "Scroll"; }
    bind "Enter" { SwitchToMode "Search"; }
  }
  renametab {
    bind "Ctrl c" { SwitchToMode "Normal"; }
    bind "Esc" { UndoRenameTab; SwitchToMode "Tab"; }
  }
  renamepane {
    bind "Ctrl c" { SwitchToMode "Normal"; }
    bind "Esc" { UndoRenamePane; SwitchToMode "Pane"; }
  }
  session {
    bind "Ctrl o" { SwitchToMode "Normal"; }
    bind "Ctrl s" { SwitchToMode "Scroll"; }
    bind "d" { Detach; }
    bind "w" {
      LaunchOrFocusPlugin "session-manager" {
          floating true
          move_to_focused_tab true
      };
      SwitchToMode "Normal"
    }
  }
  tmux {
      bind "[" { SwitchToMode "Scroll"; }
      bind "Ctrl b" { Write 2; SwitchToMode "Normal"; }
      bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }
      bind "%" { NewPane "Right"; SwitchToMode "Normal"; }
      bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
      bind "c" { NewTab; SwitchToMode "Normal"; }
      bind "," { SwitchToMode "RenameTab"; }
      bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
      bind "n" { GoToNextTab; SwitchToMode "Normal"; }
      bind "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
      bind "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
      bind "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
      bind "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
      bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
      bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }
      bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
      bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
      bind "o" { FocusNextPane; }
      bind "d" { Detach; }
      bind "Space" { NextSwapLayout; }
      bind "x" { CloseFocus; SwitchToMode "Normal"; }
  }
  shared_except "locked" {
    bind "Ctrl g" { SwitchToMode "Locked"; }
    bind "Ctrl q" { Quit; }
    // --- Ghostty muscle-memory mirror (non-modal: fire directly, no mode) ---
    // Tabs
    bind "Ctrl Shift t" { NewTab; }
    bind "Ctrl Shift Left" "Ctrl Shift Tab" "Ctrl Alt h" { GoToPreviousTab; }
    bind "Ctrl Shift Right" "Ctrl Tab" "Ctrl Alt l" { GoToNextTab; }
    bind "Ctrl PageUp" { GoToPreviousTab; }
    bind "Ctrl PageDown" { GoToNextTab; }
    bind "Alt 1" { GoToTab 1; }
    bind "Alt 2" { GoToTab 2; }
    bind "Alt 3" { GoToTab 3; }
    bind "Alt 4" { GoToTab 4; }
    bind "Alt 5" { GoToTab 5; }
    bind "Alt 6" { GoToTab 6; }
    bind "Alt 7" { GoToTab 7; }
    bind "Alt 8" { GoToTab 8; }
    // Splits (panes)
    bind "Ctrl Shift o" "F1" { NewPane "Right"; }
    bind "Ctrl Shift e" { NewPane "Down"; }
    bind "Ctrl Shift Enter" { ToggleFocusFullscreen; }
    // Focus movement: zellij's default Alt+hjkl (defined in the block below,
    // with edge-wrap to adjacent tabs). Ctrl+Alt+j/k cycle through ALL panes
    // (next/prev, not just directional) and bypass Locked (mirrored in locked).
    // Ctrl+Alt (not Ctrl+Shift) avoids the ^J/^K collision with TUI apps like
    // Claude Code, where Ctrl+Shift+j collapses to newline.
    bind "Ctrl Alt j" { FocusNextPane; }
    bind "Ctrl Alt k" { FocusPreviousPane; }
    bind "Super Ctrl [" { FocusPreviousPane; }
    bind "Super Ctrl ]" { FocusNextPane; }
    // Resize splits
    bind "Super Ctrl Shift Up" { Resize "Increase Up"; }
    bind "Super Ctrl Shift Down" { Resize "Increase Down"; }
    bind "Super Ctrl Shift Left" { Resize "Increase Left"; }
    bind "Super Ctrl Shift Right" { Resize "Increase Right"; }
    bind "Alt n" { NewPane; }
    bind "Alt i" { MoveTab "Left"; }
    bind "Alt o" { MoveTab "Right"; }
    bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
    bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
    bind "Alt j" "Alt Down" { MoveFocus "Down"; }
    bind "Alt k" "Alt Up" { MoveFocus "Up"; }
    bind "Alt =" "Alt +" { Resize "Increase"; }
    bind "Alt -" { Resize "Decrease"; }
    bind "Alt [" { PreviousSwapLayout; }
    bind "Alt ]" { NextSwapLayout; }
  }
  shared_except "normal" "locked" {
      bind "Enter" "Esc" { SwitchToMode "Normal"; }
  }
  shared_except "pane" "locked" {
      bind "Ctrl p" { SwitchToMode "Pane"; }
  }
  shared_except "resize" "locked" {
    bind "Ctrl n" { SwitchToMode "Resize"; }
  }
  shared_except "scroll" "locked" {
    bind "Ctrl s" { SwitchToMode "Scroll"; }
  }
  shared_except "session" "locked" {
    bind "Ctrl o" { SwitchToMode "Session"; }
  }
  shared_except "tab" "locked" {
    bind "Ctrl t" { SwitchToMode "Tab"; }
  }
  shared_except "move" "locked" {
    bind "Ctrl h" { SwitchToMode "Move"; }
  }
  shared_except "tmux" "locked" {
    bind "Ctrl b" { SwitchToMode "Tmux"; }
  }
}

plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    filepicker location="zellij:strider" {
        cwd "/"
    }
    // zjstatus replaces zellij:status-bar. The stock bar's per-mode hints are
    // compiled into its wasm and it has no label for MoveTab at all, so the
    // tab-reorder binding could never be advertised there no matter how it was
    // bound. Here every hint line is ours to write — which also means nothing
    // derives from the keybinds block above, so the two must be kept in sync by
    // hand. Edit a bind, edit its hint.
    //
    // Defined as an alias so the three layouts each reference `zjstatus` rather
    // than carrying their own copy of this block.
    zjstatus location="file:~/.config/zellij/plugins/zjstatus.wasm" {
        format_left  "{mode}"
        format_right "#[fg=cyan]{session} "
        format_space ""

        border_enabled "false"
        hide_frame_for_single_pane "false"

        mode_normal "#[fg=green,bold] BASE #[fg=blue]Ctrl#[fg=white] + #[fg=blue]g#[fg=white] lock #[fg=blue]p#[fg=white] pane #[fg=blue]t#[fg=white] tab #[fg=blue]n#[fg=white] resize #[fg=blue]h#[fg=white] move #[fg=blue]s#[fg=white] scroll #[fg=blue]o#[fg=white] session #[fg=blue]q#[fg=white] quit"
        mode_locked "#[fg=red,bold] LOCKED #[fg=blue]Ctrl g#[fg=white] unlock #[fg=blue]Ctrl+Alt h/l#[fg=white] tab #[fg=blue]Ctrl+Alt j/k#[fg=white] pane #[fg=blue]Alt z#[fg=white] fullscreen"
        mode_tab "#[fg=orange,bold] TAB #[fg=orange]h/l#[fg=white] move tab #[fg=orange]j/k#[fg=white] switch tab #[fg=orange]n#[fg=white] new #[fg=orange]x#[fg=white] close #[fg=orange]r#[fg=white] rename #[fg=orange]b#[fg=white] break pane #[fg=orange]1-9#[fg=white] go to #[fg=orange]Esc#[fg=white] back"
        mode_pane "#[fg=orange,bold] PANE #[fg=orange]h/j/k/l#[fg=white] focus #[fg=orange]n/d/r#[fg=white] new #[fg=orange]x#[fg=white] close #[fg=orange]f#[fg=white] fullscreen #[fg=orange]w#[fg=white] float #[fg=orange]e#[fg=white] embed #[fg=orange]c#[fg=white] rename #[fg=orange]Esc#[fg=white] back"
        mode_resize "#[fg=orange,bold] RESIZE #[fg=orange]h/j/k/l#[fg=white] grow #[fg=orange]H/J/K/L#[fg=white] shrink #[fg=orange]+/-#[fg=white] all #[fg=orange]Esc#[fg=white] back"
        mode_move "#[fg=orange,bold] MOVE #[fg=orange]h/j/k/l#[fg=white] move pane #[fg=orange]n/Tab#[fg=white] next #[fg=orange]p#[fg=white] previous #[fg=orange]Esc#[fg=white] back"
        mode_scroll "#[fg=orange,bold] SCROLL #[fg=orange]j/k#[fg=white] line #[fg=orange]Ctrl f/b#[fg=white] page #[fg=orange]d/u#[fg=white] half #[fg=orange]s#[fg=white] search #[fg=orange]e#[fg=white] edit buffer #[fg=orange]Esc#[fg=white] back"
        mode_search "#[fg=orange,bold] SEARCH #[fg=orange]n/p#[fg=white] next/prev #[fg=orange]c#[fg=white] case #[fg=orange]w#[fg=white] wrap #[fg=orange]o#[fg=white] whole word #[fg=orange]Esc#[fg=white] back"
        mode_enter_search "#[fg=yellow,bold] SEARCH #[fg=white]type a term then #[fg=yellow]Enter#[fg=white], #[fg=yellow]Esc#[fg=white] to cancel"
        mode_session "#[fg=orange,bold] SESSION #[fg=orange]d#[fg=white] detach #[fg=orange]w#[fg=white] session manager #[fg=orange]Ctrl s#[fg=white] scroll #[fg=orange]Esc#[fg=white] back"
        mode_tmux "#[fg=orange,bold] TMUX #[fg=orange]c#[fg=white] new tab #[fg=orange]n/p#[fg=white] next/prev #[fg=orange]%#[fg=white] split right #[fg=orange]\"#[fg=white] split down #[fg=orange]z#[fg=white] fullscreen #[fg=orange]d#[fg=white] detach #[fg=orange]Esc#[fg=white] back"
        mode_rename_tab "#[fg=yellow,bold] RENAME TAB #[fg=white]type a name then #[fg=yellow]Enter#[fg=white], #[fg=yellow]Esc#[fg=white] to cancel"
        mode_rename_pane "#[fg=yellow,bold] RENAME PANE #[fg=white]type a name then #[fg=yellow]Enter#[fg=white], #[fg=yellow]Esc#[fg=white] to cancel"
        mode_prompt "#[fg=yellow,bold] PROMPT "
    }
}

// Choose what to do when zellij receives SIGTERM, SIGINT, SIGQUIT or SIGHUP
// eg. when terminal window with an active zellij session is closed
// Options:
//   - detach (Default)
//   - quit
//
// on_force_close "quit"

//  Send a request for a simplified ui (without arrow fonts) to plugins
//  Options:
//    - true
//    - false (Default)
//
// simplified_ui true

// Choose the path to the default shell that zellij will use for opening new panes
// Default: $SHELL
//


// Choose the path to override cwd that zellij will use for opening new panes
//
// default_cwd ""

// Toggle between having pane frames around the panes
// Options:
//   - true (default)
//   - false
//
// pane_frames true

// Toggle between having Zellij lay out panes according to a predefined set of layouts whenever possible
// Options:
//   - true (default)
//   - false
//
// auto_layout true

// Whether sessions should be serialized to the cache folder (including their tabs/panes, cwds and running commands) so that they can later be resurrected
// Options:
//   - true (default)
//   - false
//
// session_serialization false

// Whether pane viewports are serialized along with the session, default is false
// Options:
//   - true
//   - false (default)
// serialize_pane_viewport true

// Scrollback lines to serialize along with the pane viewport when serializing sessions, 0
// defaults to the scrollback size. If this number is higher than the scrollback size, it will
// also default to the scrollback size. This does nothing if `serialize_pane_viewport` is not true.
//
// scrollback_lines_to_serialize 10000

// Define color themes for Zellij
// For more examples, see: https://github.com/zellij-org/zellij/tree/main/example/themes
// Once these themes are defined, one of them should to be selected in the "theme" section of this file
//
// themes {
//     dracula {
//         fg 248 248 242
//         bg 40 42 54
//         red 255 85 85
//         green 80 250 123
//         yellow 241 250 140
//         blue 98 114 164
//         magenta 255 121 198
//         orange 255 184 108
//         cyan 139 233 253
//         black 0 0 0
//         white 255 255 255
//     }
// }

// Choose the theme that is specified in the themes section.
// Default: default
//
// theme "default"

// The name of the default layout to load on startup.
//
// Named "base" rather than "default" deliberately: a layouts/default.kdl
// silently SHADOWS zellij's built-in default layout, so the two are
// indistinguishable at a glance and any session created outside this config
// (session-manager, welcome screen) can quietly fall back to the built-in one
// with no hint that it happened. An explicit name makes the collision
// impossible and this line the single source of truth.
default_layout "base"

// Choose the mode that zellij uses when starting up.
// Default: normal
//
// default_mode "locked"

// Toggle enabling the mouse mode.
// On certain configurations, or terminals this could
// potentially interfere with copying text.
// Options:
//   - true (default)
//   - false
//
mouse_mode true

// zellij 0.45 turned on hover effects + pane grouping by default
// (`advanced_mouse_actions`). Hover needs any-event mouse tracking (mode 1003),
// and zellij forwards those buttonless motion reports into panes that only
// requested 1002 -- nvim decodes them as <MiddleDrag>/<MiddleMouse>, and
// middle-click pastes the * register, so nudging the mouse after a left click
// pastes into the buffer. Hover is cosmetic; mouse_mode stays on, so
// copy-on-select and click-to-focus are unaffected.
advanced_mouse_actions false

// Configure the scroll back buffer size
// This is the number of lines zellij stores for each pane in the scroll back
// buffer. Excess number of lines are discarded in a FIFO fashion.
// Valid values: positive integers
// Default value: 10000
//
// scroll_buffer_size 10000

// Provide a command to execute when copying text. The text will be piped to
// the stdin of the program to perform the copy. This can be used with
// terminal emulators which do not support the OSC 52 ANSI control sequence
// that will be used by default if this option is not set.
// Examples:
//
copy_command "xclip -selection clipboard" // x11
// copy_command "wl-copy"                    // wayland
// copy_command "pbcopy"                     // osx

// Choose the destination for copied text
// Allows using the primary selection buffer (on x11/wayland) instead of the system clipboard.
// Does not apply when using copy_command.
// Options:
//   - system (default)
//   - primary
//
// copy_clipboard "primary"

// Enable or disable automatic copy (and clear) of selection when releasing mouse
// Default: true
//
// copy_on_select false

// Path to the default editor to use to edit pane scrollbuffer
// Default: $EDITOR or $VISUAL
//
// nvim (bob-managed) has clipboard support; the bare $EDITOR fallback resolves
// to vim.basic (-clipboard) in the server's frozen env, so yanks never reach X11.
scrollback_editor "/home/matthew.t/.local/share/bob/nvim-bin/nvim"

// When attaching to an existing session with other users,
// should the session be mirrored (true)
// or should each user have their own cursor (false)
// Default: false
//
// mirror_session true

// The folder in which Zellij will look for layouts
//
// layout_dir "/path/to/my/layout_dir"

// The folder in which Zellij will look for themes
//
// theme_dir "/path/to/my/theme_dir"

// Enable or disable the rendering of styled and colored underlines (undercurl).
// May need to be disabled for certain unsupported terminals
// Default: true
//
// styled_underlines false

// Enable or disable writing of session metadata to disk (if disabled, other sessions might not know
// metadata info on this session)
// Default: false
//
// disable_session_metadata true
